# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent chat & session logs
.agents/
.agile/
.claude/
.claude.json
.codex/
.cursor/
.roo/
.windsurf/
.chat*
*.session
*.jsonl

# local agent issue tracker (see docs/agents/issue-tracker.md)
.scratch/

# local agent animation plans (see plans/README.md)
/plans/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
